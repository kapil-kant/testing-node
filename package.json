{
  "name": "prep-testing-node",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Sample plain JavaScript Express backend used to test the Nexon build sandbox",
  "main": "index.js",
  "scripts": {
    "start:dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/utils/seeders/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint \"{src,apps,libs,test}/**/*.js\" --fix",
    "prepare": "husky install"
  },
  "_moduleAliases": {
    "@utils": "src/utils",
    "@middlewares": "src/app/middlewares",
    "@services": "src/services",
    "@config": "src/config"
  },
  "author": "Kapil",
  "license": "ISC",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "module-alias": "^2.2.3",
    "mongoose": "^8.0.0",
    "private-logger": "github:kapil-kant/prep-private-logger#main"
  },
  "devDependencies": {
    "eslint": "^8.53.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsdoc": "^46.4.4",
    "eslint-plugin-n": "^16.3.1",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^8.0.0",
    "nodemon": "^3.0.1"
  }
}
